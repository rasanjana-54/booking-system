rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3 & Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isVerifiedUser() && userEmailLower() == 'rnimsara54@gmail.com';
    }

    function staffDocPath() {
      return /databases/$(database)/documents/staff/$(userEmailLower());
    }

    function isActiveStaff() {
      return isSuperAdmin() || (
        isVerifiedUser()
        && exists(staffDocPath())
        && get(staffDocPath()).data.isActive == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isActiveStaff()
        && get(staffDocPath()).data.role == 'ADMIN'
      );
    }

    function isValidEmailList(listVal, maxLen) {
      return listVal is list
        && listVal.size() >= 1
        && listVal.size() <= maxLen
        && listVal[0] is string
        && listVal[0].size() <= 120;
    }

    function isValidPaymentStatus(status) {
      return status in ['UNPAID', 'PARTIALLY_PAID', 'FULLY_PAID', 'OVERPAID'];
    }

    function isValidVenueResource(venue) {
      return venue in ['Full Estate', 'Main Lawn & Poolside', 'Indoor Courtyard', 'Garden Pavilion'];
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // Validation Blueprints (Pillar 2)
    function isValidStaff(data) {
      return data.keys().hasAll([
          'email', 'name', 'role', 'slotNumber', 'isActive',
          'adminEmails', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'name', 'role', 'slotNumber', 'phone', 'isActive',
          'uid', 'lastLoginAt', 'adminEmails', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.role in ['ADMIN', 'STAFF']
        && data.slotNumber is int && data.slotNumber >= 1 && data.slotNumber <= 4
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.isActive is bool
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
        && isValidEmailList(data.adminEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEventBooking(data) {
      return data.keys().hasAll([
          'bookingCode', 'eventType', 'venueResource', 'eventDate', 'startTime', 'endTime',
          'paxCount', 'customerName', 'customerPhone', 'totalPayment', 'advancePayment',
          'duePayment', 'paymentStatus', 'status', 'isArchived', 'authorizedEmails',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingCode', 'eventType', 'venueResource', 'eventDate', 'startTime', 'endTime',
          'paxCount', 'customerName', 'customerPhone', 'totalPayment', 'advancePayment',
          'duePayment', 'paymentStatus', 'specialNotes', 'status', 'isArchived',
          'archivedAt', 'archivedBy', 'authorizedEmails', 'createdBy', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && data.bookingCode is string && data.bookingCode.size() <= 20 && data.bookingCode.matches('^EVT-[0-9]{4}-[0-9]{4}$')
        && data.eventType in ['Wedding', 'Birthday', 'Engagement', 'Corporate Event', 'Private Party', 'Other']
        && isValidVenueResource(data.venueResource)
        && isValidDateStr(data.eventDate)
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && data.paxCount is int && data.paxCount >= 1 && data.paxCount <= 1000
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30
        && data.totalPayment is number && data.totalPayment >= 0
        && data.advancePayment is number && data.advancePayment >= 0
        && data.duePayment is number && data.duePayment >= 0
        && isValidPaymentStatus(data.paymentStatus)
        && (!('specialNotes' in data) || (data.specialNotes is string && data.specialNotes.size() <= 1000))
        && data.status in ['Pending', 'Confirmed', 'Completed', 'Cancelled']
        && data.isArchived is bool
        && (!('archivedAt' in data) || data.archivedAt is timestamp || data.archivedAt == null)
        && (!('archivedBy' in data) || data.archivedBy == null || (data.archivedBy is string && data.archivedBy.size() <= 128))
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShootBooking(data) {
      return data.keys().hasAll([
          'bookingCode', 'shootDate', 'shootType', 'venueResource', 'startTime', 'endTime',
          'customerName', 'customerPhone', 'totalPayment', 'advancePayment', 'duePayment',
          'paymentStatus', 'status', 'isArchived', 'authorizedEmails',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingCode', 'shootDate', 'shootType', 'venueResource', 'startTime', 'endTime',
          'customerName', 'customerPhone', 'totalPayment', 'advancePayment', 'duePayment',
          'paymentStatus', 'specialNotes', 'status', 'isArchived', 'archivedAt', 'archivedBy',
          'authorizedEmails', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.bookingCode is string && data.bookingCode.size() <= 20 && data.bookingCode.matches('^SHT-[0-9]{4}-[0-9]{4}$')
        && isValidDateStr(data.shootDate)
        && data.shootType in ['Photography', 'Videography', 'Wedding Shoot', 'Fashion Shoot', 'Commercial Shoot', 'Other']
        && isValidVenueResource(data.venueResource)
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30
        && data.totalPayment is number && data.totalPayment >= 0
        && data.advancePayment is number && data.advancePayment >= 0
        && data.duePayment is number && data.duePayment >= 0
        && isValidPaymentStatus(data.paymentStatus)
        && (!('specialNotes' in data) || (data.specialNotes is string && data.specialNotes.size() <= 1000))
        && data.status in ['Pending', 'Confirmed', 'Completed', 'Cancelled']
        && data.isArchived is bool
        && (!('archivedAt' in data) || data.archivedAt is timestamp || data.archivedAt == null)
        && (!('archivedBy' in data) || data.archivedBy == null || (data.archivedBy is string && data.archivedBy.size() <= 128))
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomType(data) {
      return data.keys().hasAll([
          'roomCode', 'name', 'description', 'maxCapacity', 'price',
          'status', 'isArchived', 'authorizedEmails', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'name', 'description', 'maxCapacity', 'price',
          'status', 'imageUrl', 'isArchived', 'authorizedEmails', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.roomCode is string && data.roomCode.size() >= 2 && data.roomCode.size() <= 20
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.maxCapacity is int && data.maxCapacity >= 1 && data.maxCapacity <= 50
        && data.price is number && data.price >= 0
        && data.status in ['Available', 'Maintenance', 'Inactive']
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && data.isArchived is bool
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomBooking(data) {
      return data.keys().hasAll([
          'bookingCode', 'roomTypeId', 'roomTypeName', 'customerName', 'customerPhone',
          'foodStatus', 'checkInDate', 'checkInTime', 'checkOutDate', 'checkOutTime',
          'totalPayment', 'advancePayment', 'duePayment', 'paymentStatus', 'status',
          'isArchived', 'authorizedEmails', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingCode', 'roomTypeId', 'roomTypeName', 'customerName', 'customerPhone',
          'foodStatus', 'checkInDate', 'checkInTime', 'checkOutDate', 'checkOutTime',
          'totalPayment', 'advancePayment', 'duePayment', 'paymentStatus', 'specialNotes',
          'status', 'isArchived', 'archivedAt', 'archivedBy', 'authorizedEmails',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.bookingCode is string && data.bookingCode.size() <= 20 && data.bookingCode.matches('^ROM-[0-9]{4}-[0-9]{4}$')
        && isValidId(data.roomTypeId)
        && data.roomTypeName is string && data.roomTypeName.size() >= 2 && data.roomTypeName.size() <= 100
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30
        && data.foodStatus in ['Included', 'Not Included', 'Pending']
        && isValidDateStr(data.checkInDate)
        && isValidTimeStr(data.checkInTime)
        && isValidDateStr(data.checkOutDate)
        && isValidTimeStr(data.checkOutTime)
        && data.totalPayment is number && data.totalPayment >= 0
        && data.advancePayment is number && data.advancePayment >= 0
        && data.duePayment is number && data.duePayment >= 0
        && isValidPaymentStatus(data.paymentStatus)
        && (!('specialNotes' in data) || (data.specialNotes is string && data.specialNotes.size() <= 1000))
        && data.status in ['Pending', 'Confirmed', 'Checked-in', 'Checked-out', 'Cancelled']
        && data.isArchived is bool
        && (!('archivedAt' in data) || data.archivedAt is timestamp || data.archivedAt == null)
        && (!('archivedBy' in data) || data.archivedBy == null || (data.archivedBy is string && data.archivedBy.size() <= 128))
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'paymentCode', 'bookingId', 'bookingCode', 'bookingType', 'customerName',
          'amount', 'paymentMethod', 'paymentDate', 'isAdjustment', 'isVoided',
          'recordedBy', 'recordedByName', 'authorizedEmails', 'createdAt'
        ])
        && data.keys().hasOnly([
          'paymentCode', 'bookingId', 'bookingCode', 'bookingType', 'customerName',
          'amount', 'paymentMethod', 'paymentDate', 'referenceNumber', 'notes',
          'isAdjustment', 'adjustmentReason', 'isVoided', 'recordedBy', 'recordedByName',
          'authorizedEmails', 'createdAt'
        ])
        && data.paymentCode is string && data.paymentCode.size() >= 4 && data.paymentCode.size() <= 24
        && isValidId(data.bookingId)
        && data.bookingCode is string && data.bookingCode.size() <= 24
        && data.bookingType in ['EVENT', 'SHOOT', 'ROOM']
        && data.customerName is string && data.customerName.size() <= 120
        && data.amount is number && data.amount != 0
        && data.paymentMethod in ['Cash', 'Bank Transfer', 'Card', 'Other']
        && isValidDateStr(data.paymentDate)
        && (!('referenceNumber' in data) || (data.referenceNumber is string && data.referenceNumber.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.isAdjustment is bool
        && (!('adjustmentReason' in data) || (data.adjustmentReason is string && data.adjustmentReason.size() <= 300))
        && data.isVoided is bool
        && data.recordedBy is string && data.recordedBy.size() <= 128
        && data.recordedByName is string && data.recordedByName.size() <= 100
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdAt is timestamp;
    }

    function isValidBlockedSchedule(data) {
      return data.keys().hasAll([
          'scope', 'startDate', 'endDate', 'startTime', 'endTime', 'reason',
          'authorizedEmails', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'scope', 'roomTypeId', 'roomTypeName', 'startDate', 'endDate', 'startTime', 'endTime',
          'reason', 'authorizedEmails', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.scope in ['FULL_VILLA', 'EVENT_GROUNDS', 'SHOOT_GROUNDS', 'ROOM']
        && (!('roomTypeId' in data) || data.roomTypeId == null || isValidId(data.roomTypeId))
        && (!('roomTypeName' in data) || data.roomTypeName == null || (data.roomTypeName is string && data.roomTypeName.size() <= 100))
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && isValidTimeStr(data.startTime)
        && isValidTimeStr(data.endTime)
        && data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 300
        && isValidEmailList(data.authorizedEmails, 4)
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'userId', 'userEmail', 'userName', 'action', 'recordType',
          'recordId', 'summary', 'adminEmails', 'timestamp'
        ])
        && data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'action', 'recordType',
          'recordId', 'summary', 'adminEmails', 'timestamp'
        ])
        && data.userId is string && data.userId.size() <= 128
        && data.userEmail is string && data.userEmail.size() <= 120
        && data.userName is string && data.userName.size() <= 100
        && data.action is string && data.action.size() <= 60
        && data.recordType is string && data.recordType.size() <= 40
        && data.recordId is string && data.recordId.size() <= 128
        && data.summary is string && data.summary.size() <= 500
        && isValidEmailList(data.adminEmails, 4)
        && data.timestamp is timestamp;
    }

    function isValidVillaSettings(data) {
      return data.keys().hasAll([
          'villaName', 'timezone', 'currency', 'inactivityTimeoutMinutes',
          'authorizedEmails', 'adminEmails', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'villaName', 'timezone', 'currency', 'inactivityTimeoutMinutes',
          'authorizedEmails', 'adminEmails', 'updatedBy', 'updatedAt'
        ])
        && data.villaName is string && data.villaName.size() >= 2 && data.villaName.size() <= 100
        && data.timezone is string && data.timezone.size() <= 40
        && data.currency in ['LKR', 'USD']
        && data.inactivityTimeoutMinutes is int && data.inactivityTimeoutMinutes >= 5 && data.inactivityTimeoutMinutes <= 240
        && isValidEmailList(data.authorizedEmails, 4)
        && isValidEmailList(data.adminEmails, 4)
        && data.updatedBy is string && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    // Collection: staff (max 4 authorized staff slots)
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && (
        isAdmin() || (isVerifiedUser() && existing().email == userEmailLower())
      );
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || existing().email == userEmailLower()
        || userEmailLower() in existing().adminEmails
      );
      allow create: if isValidId(staffId)
        && isAdmin()
        && isValidStaff(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(staffId)
        && isValidStaff(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'role', 'slotNumber', 'phone', 'isActive', 'adminEmails', 'updatedAt', 'uid', 'lastLoginAt'
            ])
          )
          || (
            isVerifiedUser()
            && existing().email == userEmailLower()
            && existing().isActive == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'lastLoginAt', 'updatedAt'])
            && incoming().uid == request.auth.uid
          )
        );
      allow delete: if isValidId(staffId) && isAdmin() && existing().email != 'rnimsara54@gmail.com';
    }

    // Collection: events
    match /events/{eventId} {
      allow get: if isValidId(eventId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(eventId)
        && isActiveStaff()
        && isValidEventBooking(incoming())
        && incoming().isArchived == false
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(eventId)
        && isActiveStaff()
        && isValidEventBooking(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            !(existing().status in ['Completed', 'Cancelled'])
            && existing().isArchived == false
            && (
              (
                incoming().isArchived == false
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'eventType', 'venueResource', 'eventDate', 'startTime', 'endTime',
                  'paxCount', 'customerName', 'customerPhone', 'totalPayment', 'advancePayment',
                  'duePayment', 'paymentStatus', 'specialNotes', 'status', 'authorizedEmails', 'updatedAt'
                ])
              )
              || (
                incoming().isArchived == true
                && incoming().archivedBy == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'isArchived', 'archivedAt', 'archivedBy', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(eventId) && isAdmin();
    }

    // Collection: shoots
    match /shoots/{shootId} {
      allow get: if isValidId(shootId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(shootId)
        && isActiveStaff()
        && isValidShootBooking(incoming())
        && incoming().isArchived == false
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(shootId)
        && isActiveStaff()
        && isValidShootBooking(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            !(existing().status in ['Completed', 'Cancelled'])
            && existing().isArchived == false
            && (
              (
                incoming().isArchived == false
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'shootDate', 'shootType', 'venueResource', 'startTime', 'endTime',
                  'customerName', 'customerPhone', 'totalPayment', 'advancePayment',
                  'duePayment', 'paymentStatus', 'specialNotes', 'status', 'authorizedEmails', 'updatedAt'
                ])
              )
              || (
                incoming().isArchived == true
                && incoming().archivedBy == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'isArchived', 'archivedAt', 'archivedBy', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(shootId) && isAdmin();
    }

    // Collection: room_types
    match /room_types/{roomTypeId} {
      allow get: if isValidId(roomTypeId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(roomTypeId)
        && isActiveStaff()
        && isValidRoomType(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(roomTypeId)
        && isActiveStaff()
        && isValidRoomType(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'roomCode', 'name', 'description', 'maxCapacity', 'price', 'status', 'imageUrl', 'authorizedEmails', 'updatedAt'
          ])
        );
      allow delete: if isValidId(roomTypeId) && isAdmin();
    }

    // Collection: room_bookings
    match /room_bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(bookingId)
        && isActiveStaff()
        && isValidRoomBooking(incoming())
        && incoming().isArchived == false
        && exists(/databases/$(database)/documents/room_types/$(incoming().roomTypeId))
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookingId)
        && isActiveStaff()
        && isValidRoomBooking(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            !(existing().status in ['Checked-out', 'Cancelled'])
            && existing().isArchived == false
            && (
              (
                incoming().isArchived == false
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'roomTypeId', 'roomTypeName', 'customerName', 'customerPhone',
                  'foodStatus', 'checkInDate', 'checkInTime', 'checkOutDate', 'checkOutTime',
                  'totalPayment', 'advancePayment', 'duePayment', 'paymentStatus',
                  'specialNotes', 'status', 'authorizedEmails', 'updatedAt'
                ])
              )
              || (
                incoming().isArchived == true
                && incoming().archivedBy == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'isArchived', 'archivedAt', 'archivedBy', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // Collection: payments
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(paymentId)
        && isActiveStaff()
        && isValidPayment(incoming())
        && incoming().recordedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().isVoided == false
        && (
          (incoming().isAdjustment == false && incoming().amount > 0)
          || (incoming().isAdjustment == true && isAdmin())
        );
      allow update: if isValidId(paymentId)
        && isAdmin()
        && isValidPayment(incoming())
        && incoming().recordedBy == existing().recordedBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isVoided', 'adjustmentReason', 'authorizedEmails']);
      allow delete: if false;
    }

    // Collection: blocked_schedules
    match /blocked_schedules/{blockId} {
      allow get: if isValidId(blockId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create: if isValidId(blockId)
        && isActiveStaff()
        && isValidBlockedSchedule(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(blockId)
        && isAdmin()
        && isValidBlockedSchedule(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(blockId) && isActiveStaff();
    }

    // Collection: audit_logs (Admin readable only, immutable append-only)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().adminEmails
      );
      allow create: if isValidId(logId)
        && isActiveStaff()
        && isValidAuditLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // Collection: villa_settings
    match /villa_settings/{settingId} {
      allow get: if isValidId(settingId) && isActiveStaff();
      allow list: if isVerifiedUser() && (
        userEmailLower() == 'rnimsara54@gmail.com'
        || userEmailLower() in existing().authorizedEmails
      );
      allow create, update: if isValidId(settingId)
        && isAdmin()
        && isValidVillaSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
